# ==============================================================================
# 环境变量配置模板
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改 .env 中的配置值（尤其是 OPENAI_API_KEY）
#
# 注意：.env 文件包含敏感信息，请勿提交到版本控制系统
# ==============================================================================

# 阿里云百炼（通义千问）OpenAI 兼容接口 — 请替换为你自己的 API Key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4.1-flash-1017
